{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AgentTutor event v1","type":"object","additionalProperties":false,
  "required":["schema_version","event_id","timestamp","source","type","handoff_id","payload_sha256","affected_entity_ids","changes","evidence","verification","outcome","context"],
  "properties":{
    "schema_version":{"const":1},"event_id":{"type":"string","pattern":"^evt-[a-z0-9][a-z0-9-]{2,79}$"},
    "timestamp":{"type":"string","format":"date-time"},"source":{"type":"string","minLength":1},
    "type":{"enum":["BASELINE","TUTOR_SYNC","CORRECTION"]},"handoff_id":{"type":["string","null"]},
    "payload_sha256":{"type":["string","null"]},"affected_entity_ids":{"type":"array","items":{"type":"string"}},
    "changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","id","previous","new"],"properties":{"kind":{"enum":["milestone","competency","program"]},"id":{"type":"string"},"previous":{"type":["object","null"]},"new":{"type":"object"}}}},
    "evidence":{"type":"array","items":{"$ref":"handoff.schema.json#/$defs/evidence"}},
    "verification":{"enum":["CLAIMED","PRACTICED","VERIFIED","ASSESSED","COMPLETED","BLOCKED"]},
    "outcome":{"type":"string","minLength":1},
    "context":{"type":"object"},"corrects_event_id":{"type":"string"},"reason":{"type":"string"}
  }
}
